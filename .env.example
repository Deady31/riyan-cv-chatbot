# Clé API Gemini — gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase — projet gratuit sur https://supabase.com
# Usage 100% côté serveur ici (route API + script d'ingestion), donc pas de préfixe NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé service_role, uniquement utilisée côté serveur (scripts/ingest.ts) — jamais exposée au client
SUPABASE_SERVICE_ROLE_KEY=
